# =============================================================================
# Lab Resource Utilization Platform - Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# Never commit credentials or secrets to version control.

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_resource_platform
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate
JPA_DDL_AUTO=validate

# Security / JWT Configuration (Must be provided: at least 256 bits / 32 bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend-beta-flax-4nvh1p8p6p.vercel.app

# Frontend Environment Variables (used by Vite)
VITE_API_BASE_URL=http://localhost:8080/api
